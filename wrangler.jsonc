{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-website",
  "compatibility_date": "2026-08-25",

  // Static assets only — no Worker script.
  // `vite build` writes the site to dist/ and emits dist/wrangler.json, which
  // takes over from this file at deploy time. Pointing at dist/ here means a
  // deploy attempted without a build fails loudly instead of shipping nothing.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
